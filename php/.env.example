# Configuration du site PHP. Copier ce fichier en php/.env (jamais commité)
# et remplir les valeurs. Lu par app/lib/env.php.

# --- Courriel (Resend, https://resend.com) ---------------------------------
# Envoi des demandes de ramassage et des messages de contact à
# info@infoliquidationrecycle.com. Sans clé, les soumissions sont seulement
# journalisées (error_log) et le succès est retourné au client.
RESEND_API_KEY=
# Adresse expéditrice vérifiée dans Resend (domaine vérifié requis en production)
RESEND_FROM=Info Liquidation Recycle <onboarding@resend.dev>

# --- URL canonique du site ---------------------------------------------------
# SITE_URL a priorité ; NEXT_PUBLIC_SITE_URL est accepté pour compatibilité.
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# --- Dashboard /admin --------------------------------------------------------
# Page /admin/login, cookie de session signé 8 h. Protège aussi /api/ebay,
# /api/calendar et /api/google. Sans ces variables : accès refusé (fail closed).
# Mot de passe long et unique (20+ caractères recommandés).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Recommandé : clé de signature des sessions (sinon dérivée de ADMIN_PASSWORD).
# Générer avec : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ADMIN_SESSION_SECRET=

# --- Google Calendar (OAuth) -------------------------------------------------
# console.cloud.google.com > APIs & Services > Credentials (client OAuth "Web").
# Redirect URI autorisée : <origine>/api/google/callback.
# Le refresh token s'obtient via /api/google/auth-start (connecté à l'admin).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- eBay (OAuth, production) ------------------------------------------------
# developer.ebay.com > My Account > Application Keys. Le jeton d'accès est
# généré côté serveur à partir du refresh token (app/lib/ebay.php).
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_CA
# Non utilisées par le code, gardées pour référence (flow d'autorisation eBay)
EBAY_DEV_ID=
EBAY_RUNAME=

# --- Proxy -------------------------------------------------------------------
# 1 seulement si le site est derrière Cloudflare ou un proxy connu (adresse IP du visiteur)
TRUST_PROXY=
