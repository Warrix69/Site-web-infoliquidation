# Configuration du site PHP. Copier ce fichier en php/.env (jamais commité)
# et remplir les valeurs. Lu par app/lib/env.php. Sur le serveur : .env en 600.

# --- Mode -------------------------------------------------------------------
# « production » par défaut (erreurs masquées, courriel obligatoire, cookies __Host-).
# Mettre APP_ENV=development seulement sur le poste de développement.
APP_ENV=

# --- URL canonique du site (OBLIGATOIRE en production) ----------------------
# Ex. https://infoliquidationrecycle.com — sert à l'anti-CSRF (en-tête Origin)
# et à l'adresse de retour Google OAuth. Sans elle, l'admin répond 503.
SITE_URL=
# Ancien nom, accepté pour compatibilité (SITE_URL a priorité)
NEXT_PUBLIC_SITE_URL=

# --- Courriel (Resend, https://resend.com) — OBLIGATOIRE en production -------
# Envoi des demandes de ramassage et des messages de contact à
# info@infoliquidationrecycle.com. En production, sans clé ou sans expéditeur,
# les formulaires répondent une erreur (502) au lieu de perdre la demande.
RESEND_API_KEY=
# Adresse expéditrice d'un domaine vérifié dans Resend, ex. Info Liquidation Recycle <noreply@infoliquidationrecycle.com>
RESEND_FROM=

# --- Dashboard /admin --------------------------------------------------------
# Page /admin/login, cookie de session signé 8 h. Protège aussi /api/ebay,
# /api/calendar et /api/google. Sans ces variables : accès refusé (fail closed).
ADMIN_USERNAME=
# Recommandé : haché du mot de passe (20+ caractères aléatoires), généré avec
#   php php/tools/hash-password.php     (idéalement sur le serveur, cPanel → Terminal)
# Prioritaire sur ADMIN_PASSWORD. Garder les apostrophes autour de la valeur.
ADMIN_PASSWORD_HASH=
# Repli seulement (mot de passe en clair) : à retirer une fois ADMIN_PASSWORD_HASH en place.
ADMIN_PASSWORD=
# OBLIGATOIRE : clé de signature des sessions, 32+ caractères (64 recommandés). Générer avec :
#   php -r "echo bin2hex(random_bytes(32));"
ADMIN_SESSION_SECRET=

# --- Google Calendar (OAuth) -------------------------------------------------
# console.cloud.google.com > APIs & Services > Credentials (client OAuth "Web").
# Redirect URI autorisée : <SITE_URL>/api/google/callback.
# Le refresh token s'obtient via /api/google/auth-start (connecté à l'admin) et est
# enregistré dans storage/google_refresh_token.json (prioritaire sur GOOGLE_REFRESH_TOKEN).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- eBay (OAuth, production) ------------------------------------------------
# developer.ebay.com > My Account > Application Keys. Le jeton d'accès est
# généré côté serveur à partir du refresh token (app/lib/ebay.php).
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_CA
# Renouvellement en un clic (bouton « Renouveler eBay » de l'admin, /api/ebay/auth-start) :
# RuName du portail développeur eBay (User Tokens), dont « Your auth accepted URL »
# doit être <SITE_URL>/api/ebay/callback. Le nouveau jeton (18 mois) est enregistré dans
# storage/ebay_refresh_token.json, prioritaire sur EBAY_REFRESH_TOKEN, avec sa date d'expiration.
EBAY_RUNAME=
# Facultatif : date d'expiration du jeton EBAY_REFRESH_TOKEN ci-dessus (AAAA-MM-JJ), pour le rappel.
EBAY_REFRESH_TOKEN_EXPIRES=

# --- Proxy -------------------------------------------------------------------
# Adresses IP EXACTES du proxy (ex. Cloudflare, load balancer), séparées par des virgules.
# Les en-têtes X-Forwarded-For / X-Forwarded-Proto ne sont lus que si la connexion vient
# de l'une d'elles. Laisser vide sans proxy. (L'ancienne valeur « 1 » n'a plus d'effet.)
TRUST_PROXY=
