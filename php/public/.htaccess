# Info Liquidation Recycle — Apache (hébergement mutualisé / cPanel)
Options -Indexes
DirectoryIndex index.php

# Sécurité : jamais servir les fichiers cachés (.env, .git…) ni les fichiers sensibles,
# même si quelqu'un en dépose un par erreur dans le dossier public.
<FilesMatch "(^\.|\.(env|ini|log|sh|sql|bak|old|swp|md|json\.example)$|^composer\.(json|lock)$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.(?!well-known)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obligatoire
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Le dashboard et la page de connexion passent toujours par PHP (protection)
  RewriteRule ^admin/(dashboard|login)\.html$ index.php [L]

  # Fichiers et dossiers existants servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tout le reste → contrôleur frontal
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|glb|gltf|woff2|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compression : Brotli si le module est présent, sinon gzip (mod_deflate ignore une réponse déjà compressée).
# .js peut être servi en text/javascript (RFC 9239) ou application/javascript selon la version d'Apache.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

AddType model/gltf-binary .glb
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2
